digraph RuOS_Architecture {
  // 全局设置
  graph [
    fontname="Helvetica Neue, Helvetica, Arial, sans-serif",
    fontsize=14,
    rankdir=TB,
    bgcolor="#FAFBFC",
    splines=polyline,
    nodesep=0.5,
    ranksep=0.7,
    pad=0.5,
    margin=0.3,
    compound=true
  ];
  node [
    fontname="Helvetica Neue, Helvetica, Arial, sans-serif",
    fontsize=11,
    shape=box,
    style="rounded,filled",
    fillcolor="#FFFFFF",
    color="#D1D5DA",
    penwidth=1.5,
    margin="0.15,0.08"
  ];
  edge [
    color="#586069",
    arrowsize=0.7,
    penwidth=1.2
  ];

  // ═══════════════════════════════════════════════════════════════
  // User Space
  // ═══════════════════════════════════════════════════════════════
  subgraph cluster_user {
    label=<<b>📱 User Space</b>>;
    labeljust=l;
    fontsize=13;
    style="rounded,filled";
    fillcolor="#E6F7FF";
    color="#1890FF";
    penwidth=2;
    margin=15;

    UserProg [
      label=<<b>User Programs</b><br/><font point-size="9" color="#666666">sh / ls / busybox / LTP</font>>,
      fillcolor="#BAE7FF",
      color="#1890FF"
    ];
    Ulib [
      label=<<b>User Library</b><br/><font point-size="9" color="#666666">syscall wrapper</font>>,
      fillcolor="#D6E4FF",
      color="#2F54EB"
    ];
    Syscall [
      label=<<b>System Call Interface</b><br/><font point-size="9" color="#666666">Linux-compatible syscalls</font>>,
      shape=ellipse,
      fillcolor="#B7EB8F",
      color="#52C41A",
      penwidth=2
    ];

    UserProg -> Ulib [color="#1890FF"];
    Ulib -> Syscall [color="#52C41A", penwidth=1.5];
  }

  // ═══════════════════════════════════════════════════════════════
  // Kernel Space
  // ═══════════════════════════════════════════════════════════════
  subgraph cluster_kernel {
    label=<<b>⚙️ Kernel Space</b>>;
    labeljust=l;
    fontsize=13;
    style="rounded,filled";
    fillcolor="#F5F5F5";
    color="#8C8C8C";
    penwidth=2;
    margin=18;

    // ─────────────────────────────────────────────────────────────
    // Core / Interrupt
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_core {
      label=<<b>🔔 Core / Interrupt</b>>;
      labeljust=l;
      fontsize=11;
      style="rounded,filled";
      fillcolor="#FFF7E6";
      color="#FA8C16";
      penwidth=1.5;
      margin=12;

      Trap [
        label=<<b>Trap Handler</b><br/><font point-size="9" color="#666666">exception / interrupt</font>>,
        fillcolor="#FFE7BA",
        color="#FA8C16"
      ];
      IntMg [
        label=<<b>Interrupt Mgmt</b>>,
        fillcolor="#FFD591",
        color="#D46B08"
      ];
      PLIC [
        label=<<b>PLIC</b><br/><font point-size="9" color="#666666">interrupt controller</font>>,
        fillcolor="#FFC069",
        color="#D46B08"
      ];

      Trap -> IntMg -> PLIC [color="#FA8C16"];
    }

    // ─────────────────────────────────────────────────────────────
    // Memory Management
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_mem {
      label=<<b>🧠 Memory Management</b>>;
      labeljust=l;
      fontsize=11;
      style="rounded,filled";
      fillcolor="#F9F0FF";
      color="#722ED1";
      penwidth=1.5;
      margin=12;

      PMM [
        label=<<b>PMM</b><br/><font point-size="9" color="#666666">Buddy Allocator</font>>,
        fillcolor="#EFDBFF",
        color="#722ED1"
      ];
      VMM [
        label=<<b>VMM</b><br/><font point-size="9" color="#666666">Page Table (Sv39)</font>>,
        fillcolor="#D3ADF7",
        color="#531DAB"
      ];
      MM [
        label=<<b>Slab Allocator</b><br/><font point-size="9" color="#666666">kmalloc</font>>,
        fillcolor="#B37FEB",
        color="#391085"
      ];
      COW [
        label=<<b>COW / Lazy Alloc</b><br/><font point-size="9" color="#666666">zero page / demand</font>>,
        fillcolor="#9254DE",
        color="#22075E",
        fontcolor="white"
      ];

      PMM -> VMM -> MM -> COW [color="#722ED1"];
    }

    // ─────────────────────────────────────────────────────────────
    // Process / Signal / Scheduler
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_proc {
      label=<<b>🔄 Process / Signal / Scheduler</b>>;
      labeljust=l;
      fontsize=11;
      style="rounded,filled";
      fillcolor="#E6FFFB";
      color="#13C2C2";
      penwidth=1.5;
      margin=12;

      Proc [
        label=<<b>Process Mgmt</b><br/><font point-size="9" color="#666666">fork / exec / exit / wait</font>>,
        fillcolor="#B5F5EC",
        color="#13C2C2"
      ];
      Sig [
        label=<<b>Signal Subsystem</b><br/><font point-size="9" color="#666666">pending / mask / handler</font>>,
        fillcolor="#87E8DE",
        color="#006D75"
      ];
      Sched [
        label=<<b>Scheduler (MLFQ)</b><br/><font point-size="9" color="#666666">multi-level feedback</font>>,
        fillcolor="#5CDBD3",
        color="#00474F"
      ];

      Sig -> Proc [color="#13C2C2"];
      Sched -> Proc [color="#13C2C2"];
    }

    // ─────────────────────────────────────────────────────────────
    // Program Loader
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_loader {
      label=<<b>📦 Program Loader</b>>;
      labeljust=l;
      fontsize=11;
      style="rounded,filled";
      fillcolor="#FFF0F6";
      color="#EB2F96";
      penwidth=1.5;
      margin=12;

      ELF [
        label=<<b>ELF Loader</b><br/><font point-size="9" color="#666666">PT_INTERP / auxv / PIE</font>>,
        fillcolor="#FFD6E7",
        color="#EB2F96"
      ];
      MPROT [
        label=<<b>mprotect</b><br/><font point-size="9" color="#666666">RELRO / NX</font>>,
        fillcolor="#FFADD2",
        color="#C41D7F"
      ];

      ELF -> MPROT [color="#EB2F96"];
    }

    // ─────────────────────────────────────────────────────────────
    // File System
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_fs {
      label=<<b>📁 File System</b>>;
      labeljust=l;
      fontsize=11;
      style="rounded,filled";
      fillcolor="#F6FFED";
      color="#52C41A";
      penwidth=1.5;
      margin=12;

      VFS [
        label=<<b>VFS Layer</b><br/><font point-size="9" color="#666666">unified interface</font>>,
        fillcolor="#D9F7BE",
        color="#52C41A"
      ];
      xv6fs [
        label="xv6fs",
        shape=ellipse,
        fillcolor="#B7EB8F",
        color="#389E0D"
      ];
      FAT32 [
        label="FAT32",
        shape=ellipse,
        fillcolor="#95DE64",
        color="#237804"
      ];
      EXT4 [
        label="EXT4",
        shape=ellipse,
        fillcolor="#73D13D",
        color="#135200",
        fontcolor="white"
      ];
      BDev [
        label=<<b>Block Device</b><br/><font point-size="9" color="#666666">buffer cache</font>>,
        fillcolor="#52C41A",
        color="#092B00",
        fontcolor="white"
      ];

      VFS -> xv6fs -> BDev [color="#52C41A"];
      VFS -> FAT32 -> BDev [color="#52C41A"];
      VFS -> EXT4 -> BDev [color="#52C41A"];
    }

    // ─────────────────────────────────────────────────────────────
    // Network
    // ─────────────────────────────────────────────────────────────
    subgraph cluster_net {
      label=<<b>🌐 Network</b>>;
      labeljust=l;
      fontsize=11;
      style="rounded,filled";
      fillcolor="#E6F7FF";
      color="#1890FF";
      penwidth=1.5;
      margin=12;

      ONPS [
        label=<<b>ONPS Stack</b><br/><font point-size="9" color="#666666">TCP/IP protocol</font>>,
        fillcolor="#BAE7FF",
        color="#1890FF"
      ];
      TCP [
        label="TCP / UDP",
        fillcolor="#91D5FF",
        color="#096DD9"
      ];
      LOOP [
        label="Loopback",
        fillcolor="#69C0FF",
        color="#0050B3"
      ];
      TAP [
        label=<<b>TAP</b><br/><font point-size="9" color="#666666">host bridge</font>>,
        fillcolor="#40A9FF",
        color="#003A8C",
        fontcolor="white"
      ];

      ONPS -> TCP [color="#1890FF"];
      ONPS -> LOOP [color="#1890FF"];
      ONPS -> TAP [color="#1890FF"];
    }

    // Syscall fan-out (跨子图连接)
    Syscall -> Proc [color="#52C41A", style=dashed, penwidth=1.5];
    Syscall -> Sig [color="#52C41A", style=dashed, penwidth=1.5];
    Syscall -> ELF [color="#52C41A", style=dashed, penwidth=1.5];
    Syscall -> VFS [color="#52C41A", style=dashed, penwidth=1.5];
    Syscall -> ONPS [color="#52C41A", style=dashed, penwidth=1.5];
  }

  // ═══════════════════════════════════════════════════════════════
  // Drivers / HAL / Hardware
  // ═══════════════════════════════════════════════════════════════
  subgraph cluster_hw {
    label=<<b>🔧 Drivers / HAL / Hardware</b>>;
    labeljust=l;
    fontsize=13;
    style="rounded,filled";
    fillcolor="#FFF1F0";
    color="#F5222D";
    penwidth=2;
    margin=15;

    UART [
      label=<<b>UART</b><br/><font point-size="9" color="#666666">console I/O</font>>,
      fillcolor="#FFCCC7",
      color="#F5222D"
    ];
    VDisk [
      label=<<b>VirtIO Disk</b><br/><font point-size="9" color="#666666">block I/O</font>>,
      fillcolor="#FFA39E",
      color="#CF1322"
    ];
    VNet [
      label=<<b>VirtIO Net</b><br/><font point-size="9" color="#666666">network I/O</font>>,
      fillcolor="#FF7875",
      color="#A8071A"
    ];
    HAL [
      label=<<b>HAL</b><br/><font point-size="9" color="#666666">hardware abstraction</font>>,
      fillcolor="#FF4D4F",
      color="#820014",
      fontcolor="white"
    ];
    CPU [
      label=<<b>RISC-V CPU</b><br/><font point-size="9" color="#CCCCCC">RV64GC</font>>,
      fillcolor="#A8071A",
      color="#5C0011",
      fontcolor="white"
    ];
    QEMU [
      label=<<b>QEMU virt</b><br/><font point-size="9" color="#CCCCCC">platform</font>>,
      fillcolor="#820014",
      color="#5C0011",
      fontcolor="white",
      shape=box3d
    ];

    HAL -> CPU [color="#F5222D"];
    QEMU -> HAL [color="#F5222D", style=dashed];
  }

  // ═══════════════════════════════════════════════════════════════
  // 跨层连接
  // ═══════════════════════════════════════════════════════════════
  PLIC -> UART [color="#FA8C16", constraint=false];
  PLIC -> VDisk [color="#FA8C16", constraint=false];
  PLIC -> VNet [color="#FA8C16", constraint=false];
  BDev -> VDisk [color="#52C41A", penwidth=1.5];
  ONPS -> VNet [color="#1890FF", penwidth=1.5];
}