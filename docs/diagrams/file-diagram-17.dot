digraph Diagram {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad="0.25",
    nodesep="0.50",
    ranksep="0.60"
  ];
  edge [color="#2f8f8a", penwidth=1.2, arrowsize=0.8];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#bfe6e3",
    color="#2f8f8a",
    fontcolor="#0f172a",
    fontname="Noto Sans Mono CJK SC",
    fontsize=12,
    margin="0.22,0.16"
  ];
  b1 [label="解析参数和标志位\l"];
  b2 [label="规范化路径（处理相对路径）\l- dirfd=AT_FDCWD → CWD\l- dirfd>=0 → 相对于目录fd\l"];
  b3 [label="VFS路径解析：namei(path)\l- ext4_mode → ext4_namei\l- fat32_mode → fat32_namei\l- 默认 → xv6fs namex\l"];
  b1 -> b2;
  b2 -> b3;
}
