digraph stack_layout {
  graph [fontname="Helvetica", rankdir="TB", bgcolor="white"];
  node [fontname="Helvetica", fontsize=11, shape=plaintext];
  edge [style=invis];

  // 顶部标签（高地址 = 栈底）
  top_label [label=<<B>High Address (Bottom of Stack)</B>>];

  // 栈内容使用HTML表格定义，确保布局精准
  stack [label=<
    <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <!-- 字符串区域：高地址部分 -->
      <TR>
        <TD WIDTH="300" BGCOLOR="#f0f8ff">Environment Variable Strings<BR/><FONT POINT-SIZE="9">(e.g., "PATH=/bin", "HOME=/home/user", ...)</FONT></TD>
      </TR>
      <TR>
        <TD BGCOLOR="#f0f8ff">Command-line Argument Strings<BR/><FONT POINT-SIZE="9">(e.g., "ls", "-l", "/home", ...)</FONT></TD>
      </TR>
      <!-- 指针数组区域 -->
      <TR><TD BGCOLOR="#fffacd">NULL (0)</TD></TR>

      <TR><TD BGCOLOR="#fffacd">...</TD></TR>
      <TR><TD BGCOLOR="#fffacd">envp[1]</TD></TR>
      <TR><TD BGCOLOR="#fffacd">envp[0] → Address of first env string</TD></TR>

      <TR><TD BGCOLOR="#fffacd">NULL (0)</TD></TR>
      <TR><TD BGCOLOR="#fffacd">argv[argc-1]</TD></TR>
      <TR><TD BGCOLOR="#fffacd">...</TD></TR>
      <TR><TD BGCOLOR="#fffacd">argv[1] → Address of next env string</TD></TR>
      <TR><TD BGCOLOR="#fffacd">argv[0] → Address of first arg string</TD></TR>




      <!-- 辅助向量区域：修正位置，移至此处 -->
      <TR>
        <TD BGCOLOR="#e6e6fa">Auxiliary Vector (auxv[]) <BR/>
          <FONT POINT-SIZE="9">AT_PHDR (Program Header address)<BR/>
          AT_PHENT (Size of program header entry)<BR/>
          AT_PHNUM (Number of program headers)<BR/>
          AT_ENTRY (Program entry point address)<BR/>
          ...<BR/>
          AT_NULL (End of vector)</FONT>
        </TD>
      </TR>
      <!-- 栈顶区域 -->
      <TR>
        <TD BGCOLOR="#f5f5f5">argc (Argument count, e.g., 3)</TD>
      </TR>
    </TABLE>
  >];

  // 底部标签和箭头（低地址 = 栈顶SP）
  bottom_label [label=<<B>Low Address (Stack Pointer - SP)</B>>];
  arrow [label="", shape=triangle, style=filled, fillcolor="#333333", width=0.4, height=0.3, orientation=180]; // 箭头朝上表示栈向低地址增长

  // 连接顺序：从上到下
  top_label -> stack -> arrow -> bottom_label;
}