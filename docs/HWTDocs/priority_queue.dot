// 优先级队列数据结构图
// 使用 Graphviz DOT 语言
// 编译命令: dot -Tpng priority_queue.dot -o priority_queue.png

digraph priority_queue {
    rankdir=LR;
    fontname="SimHei";
    node [fontname="SimHei"];
    edge [fontname="SimHei"];
    
    // 标题
    labelloc="t";
    label="优先级队列数据结构";
    fontsize=18;
    
    // runqueue 结构体
    subgraph cluster_runqueue {
        label="runqueue (全局运行队列)";
        style=filled;
        color=lightblue;
        
        lock [label="spinlock lock", shape=box, fillcolor=lightyellow];
        
        // head 数组
        subgraph cluster_head {
            label="head[NPRIO]";
            style=solid;
            head0 [label="head[0]\n(prio=1)", shape=box, fillcolor=lightgreen];
            head1 [label="head[1]\n(prio=2)", shape=box, fillcolor=lightgreen];
            head2 [label="head[2]\n(prio=3)", shape=box, fillcolor=lightgreen];
            hdots [label="...", shape=none];
            head19 [label="head[19]\n(prio=20)", shape=box, fillcolor=lightgreen];
            hdots2 [label="...", shape=none];
            head39 [label="head[39]\n(prio=40)", shape=box, fillcolor=lightgreen];
        }
        
        // tail 数组
        subgraph cluster_tail {
            label="tail[NPRIO]";
            style=solid;
            tail0 [label="tail[0]", shape=box, fillcolor=lightyellow];
            tail1 [label="tail[1]", shape=box, fillcolor=lightyellow];
            tail2 [label="tail[2]", shape=box, fillcolor=lightyellow];
            tdots [label="...", shape=none];
            tail19 [label="tail[19]", shape=box, fillcolor=lightyellow];
            tdots2 [label="...", shape=none];
            tail39 [label="tail[39]", shape=box, fillcolor=lightyellow];
        }
    }
    
    // 进程节点（队列中的进程）
    subgraph cluster_procs {
        label="进程链表";
        style=dashed;
        color=gray;
        
        // 优先级1队列
        p1 [label="P1\nprio=1", shape=ellipse, fillcolor=lightpink];
        p5 [label="P5\nprio=1", shape=ellipse, fillcolor=lightpink];
        
        // 优先级2队列
        p2 [label="P2\nprio=2", shape=ellipse, fillcolor=lightpink];
        
        // 优先级20队列（默认）
        p3 [label="P3\nprio=20", shape=ellipse, fillcolor=lightpink];
        p4 [label="P4\nprio=20", shape=ellipse, fillcolor=lightpink];
        p6 [label="P6\nprio=20", shape=ellipse, fillcolor=lightpink];
        
        // 优先级40队列
        p7 [label="P7\nprio=40", shape=ellipse, fillcolor=lightpink];
    }
    
    // NULL 节点
    null1 [label="NULL", shape=plaintext];
    null2 [label="NULL", shape=plaintext];
    null3 [label="NULL", shape=plaintext];
    null4 [label="NULL", shape=plaintext];
    
    // 连接 head 到进程
    head0 -> p1 [color=blue];
    p1 -> p5 [label="next", color=blue];
    p5 -> null1 [color=blue];
    tail0 -> p5 [color=red, style=dashed];
    
    head1 -> p2 [color=blue];
    p2 -> null2 [color=blue];
    tail1 -> p2 [color=red, style=dashed];
    
    head2 -> null3 [label="空队列", color=gray, style=dashed];
    
    head19 -> p3 [color=blue];
    p3 -> p4 [label="next", color=blue];
    p4 -> p6 [label="next", color=blue];
    p6 -> null4 [color=blue];
    tail19 -> p6 [color=red, style=dashed];
    
    head39 -> p7 [color=blue];
    tail39 -> p7 [color=red, style=dashed];
    
    // 图例
    subgraph cluster_legend {
        label="图例";
        style=solid;
        color=black;
        
        leg1 [label="→ head指针链", shape=none];
        leg2 [label="--→ tail指针", shape=none];
        leg3 [label="调度顺序:\n高优先级 → 低优先级", shape=box, fillcolor=white];
    }
}
