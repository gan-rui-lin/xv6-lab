digraph SchedulerEvolution {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad="0.25",
    nodesep="0.60",
    ranksep="0.60"
  ];
  edge [color="#2f8f8a", penwidth=1.2, arrowsize=0.8];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#bfe6e3",
    color="#2f8f8a",
    fontcolor="#0f172a",
    fontname="Noto Sans CJK SC",
    fontsize=12,
    margin="0.18,0.12",
    fixedsize=true,
    width=6.4,
    height=0.95
  ];

  v1 [label="Version 1: 轮转调度"];
  v2 [label="Version 2: 优先级调度", fillcolor="#d8f1ef"];
  v3 [label="Version 3: 优先级队列调度", fillcolor="#d8f1ef"];

  v1 -> v2;
  v2 -> v3;
}
