digraph Diagram {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad="0.25",
    nodesep="0.50",
    ranksep="0.60"
  ];
  edge [color="#2f8f8a", penwidth=1.2, arrowsize=0.8];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#bfe6e3",
    color="#2f8f8a",
    fontcolor="#0f172a",
    fontname="Noto Sans Mono CJK SC",
    fontsize=12,
    margin="0.22,0.16"
  ];
  n0 [label="文件名       →  SFN编码（11字节）\l────────────────────────────────\l\"README.TXT\" →  \"README  TXT\"\l\"hello.c\"    →  \"HELLO   C  \"\l\"test\"       →  \"TEST       \"\l\"a.txt\"      →  \"A       TXT\"\l"];
}
