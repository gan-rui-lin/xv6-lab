// 调度器流程图 - 三种调度算法对比
// 使用 Graphviz DOT 语言
// 编译命令: dot -Tpng scheduler_flow.dot -o scheduler_flow.png

digraph scheduler_comparison {
    rankdir=TB;
    fontname="SimHei";
    node [fontname="SimHei", shape=box, style="rounded,filled"];
    edge [fontname="SimHei"];
    
    // 标题
    labelloc="t";
    label="xv6 调度器演进 - 三种调度算法流程对比";
    fontsize=20;
    
    // ========== 版本一：轮转调度 ==========
    subgraph cluster_rr {
        label="版本一：轮转调度 (Round-Robin)";
        style=filled;
        color=lightblue;
        fontsize=14;
        
        rr_start [label="调度器开始", fillcolor=lightgreen];
        rr_intr [label="开启中断\nintr_on()", fillcolor=lightyellow];
        rr_loop [label="遍历进程表\nfor(p = proc; ...)", fillcolor=white];
        rr_check [label="p->state == RUNNABLE?", shape=diamond, fillcolor=lightyellow];
        rr_run [label="运行进程\np->state = RUNNING\nswtch()", fillcolor=lightpink];
        rr_next [label="下一个进程\np++", fillcolor=white];
        rr_done [label="遍历完成?", shape=diamond, fillcolor=lightyellow];
        
        rr_start -> rr_intr;
        rr_intr -> rr_loop;
        rr_loop -> rr_check;
        rr_check -> rr_run [label="是"];
        rr_check -> rr_next [label="否"];
        rr_run -> rr_next;
        rr_next -> rr_done;
        rr_done -> rr_loop [label="否"];
        rr_done -> rr_intr [label="是\n重新开始"];
    }
    
    // ========== 版本二：优先级调度 ==========
    subgraph cluster_prio {
        label="版本二：优先级调度 (Priority)";
        style=filled;
        color=lightgreen;
        fontsize=14;
        
        prio_start [label="调度器开始", fillcolor=lightgreen];
        prio_intr [label="开启中断\nintr_on()", fillcolor=lightyellow];
        prio_init [label="初始化\nhighest_prio = MAX+1", fillcolor=white];
        prio_loop [label="遍历进程表\nfor(p = proc; ...)", fillcolor=white];
        prio_check [label="RUNNABLE且\n优先级更高?", shape=diamond, fillcolor=lightyellow];
        prio_update [label="更新最高优先级进程\nhighest_prio_proc = p", fillcolor=lightpink];
        prio_next [label="下一个进程", fillcolor=white];
        prio_done [label="遍历完成?", shape=diamond, fillcolor=lightyellow];
        prio_found [label="找到进程?", shape=diamond, fillcolor=lightyellow];
        prio_run [label="运行最高优先级进程\nswtch()", fillcolor=lightpink];
        
        prio_start -> prio_intr;
        prio_intr -> prio_init;
        prio_init -> prio_loop;
        prio_loop -> prio_check;
        prio_check -> prio_update [label="是"];
        prio_check -> prio_next [label="否"];
        prio_update -> prio_next;
        prio_next -> prio_done;
        prio_done -> prio_loop [label="否"];
        prio_done -> prio_found [label="是"];
        prio_found -> prio_run [label="是"];
        prio_found -> prio_intr [label="否"];
        prio_run -> prio_intr;
    }
    
    // ========== 版本三：优先级队列调度 ==========
    subgraph cluster_queue {
        label="版本三：优先级队列调度 (Priority Queue)";
        style=filled;
        color=lightyellow;
        fontsize=14;
        
        q_start [label="调度器开始", fillcolor=lightgreen];
        q_intr [label="开启中断\nintr_on()", fillcolor=lightyellow];
        q_lock [label="获取队列锁\nacquire(&runqueue.lock)", fillcolor=white];
        q_dequeue [label="出队\np = dequeue()", fillcolor=lightpink];
        q_unlock [label="释放队列锁\nrelease(&runqueue.lock)", fillcolor=white];
        q_check [label="p != NULL?", shape=diamond, fillcolor=lightyellow];
        q_run [label="运行进程\np->state = RUNNING\nswtch()", fillcolor=lightpink];
        
        q_start -> q_intr;
        q_intr -> q_lock;
        q_lock -> q_dequeue;
        q_dequeue -> q_unlock;
        q_unlock -> q_check;
        q_check -> q_run [label="是"];
        q_check -> q_intr [label="否"];
        q_run -> q_intr;
    }
    
    // 算法间的演进关系（虚线箭头）
    edge [style=dashed, color=gray];
    rr_start -> prio_start [label="演进", constraint=false];
    prio_start -> q_start [label="演进", constraint=false];
}
