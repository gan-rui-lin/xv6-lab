// 调度算法演进时间线
// 使用 Graphviz DOT 语言
// 编译命令: dot -Tpng evolution.dot -o evolution.png

digraph evolution {
    rankdir=LR;
    fontname="SimHei";
    node [fontname="SimHei"];
    edge [fontname="SimHei"];
    
    // 标题
    labelloc="t";
    label="xv6 调度算法演进路径";
    fontsize=20;
    
    // 版本节点
    node [shape=box, style="rounded,filled"];
    
    v1 [label="版本一\n轮转调度\n(Round-Robin)", fillcolor=lightblue, width=2];
    v2 [label="版本二\n优先级调度\n(Priority)", fillcolor=lightgreen, width=2];
    v3 [label="版本三\n优先级队列调度\n(Priority Queue)", fillcolor=lightyellow, width=2];
    
    // 特点说明节点
    node [shape=note, style=filled, fillcolor=white];
    
    f1 [label="特点:\n• 实现简单\n• 完全公平\n• O(n)复杂度"];
    f2 [label="改进:\n• 引入优先级\n• 重要任务优先\n• 仍是O(n)"];
    f3 [label="优化:\n• 多队列结构\n• O(1)入队出队\n• 同优先级FIFO"];
    
    // 连接
    v1 -> v2 [label="引入优先级", style=bold, color=blue];
    v2 -> v3 [label="优化数据结构", style=bold, color=blue];
    
    v1 -> f1 [style=dashed, color=gray];
    v2 -> f2 [style=dashed, color=gray];
    v3 -> f3 [style=dashed, color=gray];
    
    // 复杂度对比
    subgraph cluster_complexity {
        label="时间复杂度对比";
        style=filled;
        color=lightgray;
        
        node [shape=box, style=filled];
        
        c1 [label="V1: O(n)", fillcolor=lightblue];
        c2 [label="V2: O(n)", fillcolor=lightgreen];
        c3 [label="V3: O(k)+O(1)", fillcolor=lightyellow];
        
        c1 -> c2 -> c3 [style=invis];
    }
    
    // 布局调整
    {rank=same; v1; f1;}
    {rank=same; v2; f2;}
    {rank=same; v3; f3;}
}
