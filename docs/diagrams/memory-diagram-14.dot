digraph Diagram {
  graph [
    rankdir=TB,
    bgcolor="transparent",
    pad="0.25",
    nodesep="0.50",
    ranksep="0.60"
  ];
  edge [color="#2f8f8a", penwidth=1.2, arrowsize=0.8];
  node [
    shape=box,
    style="rounded,filled",
    fillcolor="#bfe6e3",
    color="#2f8f8a",
    fontcolor="#0f172a",
    fontname="Noto Sans Mono CJK SC",
    fontsize=12,
    margin="0.22,0.16"
  ];
  b1 [label="PA1  │ ──复制物理页──→  │ PA2  │  浪费内\lPA3  │ ──复制物理页──→  │ PA4  │  for\lPA5  │ ──复制物理页──→  │ PA6\l"];
  b2 [label="PA1  │ ←────共享────→   │ PA1\lPA3  │ ←────共享────→   │ PA3\lPA5  │ ←────共享────→   │ PA5\l"];
  b1 -> b2;
}
